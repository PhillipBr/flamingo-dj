# FRONTEND-ONLY VALUES
# Safe to expose to the browser when your Supabase RLS policies are correct.
# For GitHub Pages, add these as GitHub repository Actions secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional local override.
# Leave "/" for normal localhost development.
VITE_BASE_PATH=/

# NEVER put these in a VITE_* variable:
# SUPABASE_SERVICE_ROLE_KEY=
# SPOTIFY_CLIENT_SECRET=
